+/* The cache owns ordinary RAM comparison bytes, never a readback pointer into
+ * a write-combined UPLOAD resource. Its entries are private to this command
+ * buffer and discarded on reset. Limits: 4096 entries and 4MiB shadow bytes.
+ */
+struct dzn_snapshot_region {
+   uint64_t key[4]; /* buffer identity, generation, source offset, source size */
+   uint64_t gpuva;
+   uint8_t bytes[];
+};
+static uint32_t
+dzn_snapshot_region_hash(const void *key)
+{
+   return _mesa_hash_data(key, sizeof(((struct dzn_snapshot_region *)0)->key));
+}
+static bool
+dzn_snapshot_region_equal(const void *a, const void *b)
+{
+   return !memcmp(a, b, sizeof(((struct dzn_snapshot_region *)0)->key));
+}
+static void
+dzn_snapshot_region_free(struct hash_entry *entry)
+{
+   free(entry->data);
+}
+
+/* A cache entry owns exactly one D3D reference and any persistent CPU map.
+ * Ownership moves from a retired command buffer into the cache and then into
+ * one new command buffer. No application VkBuffer/VkDeviceMemory is cached.
+ */
+static bool
+dzn_upload_pool_put(struct dzn_device *device, const struct dzn_internal_resource *res)
+{
+   if (!device->upload_pool_initialized || !res->upload_pool_eligible ||
+       res->size > device->upload_pool_limit)
+      return false;
+   struct dzn_upload_cache_entry *entry = malloc(sizeof(*entry));
+   if (!entry)
+      return false;
+   *entry = (struct dzn_upload_cache_entry) {
+      .res = res->res, .size = res->size, .map = res->snapshot_map, .gpuva = res->gpuva,
+   };
+   bool cached = false;
+   mtx_lock(&device->upload_pool_lock);
+   if (res->size <= device->upload_pool_limit - device->upload_pool_bytes) {
+      entry->next = device->upload_pool;
+      device->upload_pool = entry;
+      device->upload_pool_bytes += res->size;
+      device->upload_pool_peak = MAX2(device->upload_pool_peak, device->upload_pool_bytes);
+      device->upload_pool_returns++;
+      cached = true;
+   } else {
+      device->upload_pool_drops++;
+   }
+   mtx_unlock(&device->upload_pool_lock);
+   if (!cached)
+      free(entry);
+   return cached;
+}
+
+static struct dzn_upload_cache_entry *
+dzn_upload_pool_take(struct dzn_device *device, uint64_t size)
+{
+   struct dzn_upload_cache_entry **best = NULL;
+   mtx_lock(&device->upload_pool_lock);
+   for (struct dzn_upload_cache_entry **p = &device->upload_pool; *p; p = &(*p)->next) {
+      if ((*p)->size >= size && (!best || (*p)->size < (*best)->size)) {
+         best = p;
+         if ((*p)->size == size)
+            break;
+      }
+   }
+   struct dzn_upload_cache_entry *entry = best ? *best : NULL;
+   if (entry) {
+      *best = entry->next;
+      device->upload_pool_bytes -= entry->size;
+      device->upload_pool_hits++;
+   } else {
+      device->upload_pool_misses++;
+   }
+   mtx_unlock(&device->upload_pool_lock);
+   return entry;
+}
+
+void
+dzn_upload_pool_finish(struct dzn_device *device)
+{
+   if (!device->upload_pool_initialized)
+      return;
+   if (device->profile_descriptors)
+      fprintf(stderr, "DZN_UPLOAD_POOL_SUMMARY hits=%llu misses=%llu returns=%llu drops=%llu retained_bytes=%llu peak_bytes=%llu limit_bytes=%llu\n",
+         (unsigned long long)device->upload_pool_hits, (unsigned long long)device->upload_pool_misses,
+         (unsigned long long)device->upload_pool_returns, (unsigned long long)device->upload_pool_drops,
+         (unsigned long long)device->upload_pool_bytes, (unsigned long long)device->upload_pool_peak,
+         (unsigned long long)device->upload_pool_limit);
+   struct dzn_upload_cache_entry *entry = device->upload_pool;
+   while (entry) {
+      struct dzn_upload_cache_entry *next = entry->next;
+      if (entry->map)
+         ID3D12Resource_Unmap(entry->res, 0, NULL);
+      ID3D12Resource_Release(entry->res);
+      free(entry);
+      entry = next;
+   }
+   device->upload_pool = NULL;
+   device->upload_pool_bytes = 0;
+   mtx_destroy(&device->upload_pool_lock);
+   device->upload_pool_initialized = false;
+}
