+static HRESULT
+dzn_cpu_descriptor_heap_alloc(struct dzn_descriptor_heap *heap,
+                              struct dzn_device *device,
+                              D3D12_DESCRIPTOR_HEAP_TYPE type,
+                              uint32_t count)
+{
+   mtx_lock(&device->cpu_descriptor_pool_lock);
+   struct dzn_cpu_descriptor_page *page;
+   uint64_t allocation = 0;
+   for (page = device->cpu_descriptor_pages; page; page = page->next) {
+      if (page->type == type)
+         allocation = util_vma_heap_alloc(&page->slots, count, 1);
+      if (allocation)
+         break;
+   }
+   HRESULT result = S_OK;
+   if (!page) {
+      page = calloc(1, sizeof(*page));
+      if (!page) {
+         result = E_OUTOFMEMORY;
+         goto done;
+      }
+      uint32_t capacity = MAX2(count, 65536);
+      D3D12_DESCRIPTOR_HEAP_DESC desc = {
+         .Type = type, .NumDescriptors = capacity,
+         .Flags = D3D12_DESCRIPTOR_HEAP_FLAG_NONE,
+      };
+      result = ID3D12Device1_CreateDescriptorHeap(device->dev, &desc,
+         &IID_ID3D12DescriptorHeap, (void **)&page->heap);
+      if (FAILED(result)) {
+         free(page);
+         goto done;
+      }
+      page->type = type;
+      page->cpu_base = dzn_ID3D12DescriptorHeap_GetCPUDescriptorHandleForHeapStart(page->heap).ptr;
+      util_vma_heap_init(&page->slots, 1, capacity);
+      allocation = util_vma_heap_alloc(&page->slots, count, 1);
+      if (!allocation) {
+         util_vma_heap_finish(&page->slots);
+         ID3D12DescriptorHeap_Release(page->heap);
+         free(page);
+         result = E_OUTOFMEMORY;
+         goto done;
+      }
+      page->next = device->cpu_descriptor_pages;
+      device->cpu_descriptor_pages = page;
+      device->cpu_descriptor_pages_created++;
+      device->cpu_descriptor_pages_live++;
+      device->cpu_descriptor_pages_peak = MAX2(device->cpu_descriptor_pages_peak,
+         device->cpu_descriptor_pages_live);
+   } else {
+      device->cpu_descriptor_reuses++;
+   }
+   page->refs++;
+   heap->cpu_page = page;
+   heap->cpu_owner = device;
+   heap->cpu_allocation = allocation;
+   heap->heap = page->heap;
+   ID3D12DescriptorHeap_AddRef(heap->heap);
+   heap->cpu_base = page->cpu_base + (allocation - 1) * heap->desc_sz;
+   heap->gpu_base = 0;
+   device->cpu_descriptor_allocations++;
+done:
+   mtx_unlock(&device->cpu_descriptor_pool_lock);
+   return result;
+}
+
+static void
+dzn_cpu_descriptor_heap_free(struct dzn_descriptor_heap *heap)
+{
+   if (!heap->cpu_page)
+      return;
+   struct dzn_device *device = heap->cpu_owner;
+   struct dzn_cpu_descriptor_page *page = heap->cpu_page;
+   mtx_lock(&device->cpu_descriptor_pool_lock);
+   util_vma_heap_free(&page->slots, heap->cpu_allocation, heap->desc_count);
+   assert(page->refs > 0);
+   if (!--page->refs) {
+      struct dzn_cpu_descriptor_page **link = &device->cpu_descriptor_pages;
+      while (*link != page)
+         link = &(*link)->next;
+      *link = page->next;
+      util_vma_heap_finish(&page->slots);
+      ID3D12DescriptorHeap_Release(page->heap);
+      free(page);
+      device->cpu_descriptor_pages_live--;
+   }
+   mtx_unlock(&device->cpu_descriptor_pool_lock);
+   heap->cpu_page = NULL;
+}
+
+void
+dzn_cpu_descriptor_pool_finish(struct dzn_device *device)
+{
+   if (!device->cpu_descriptor_pool_initialized)
+      return;
+   if (debug_get_bool_option("DZN_TRACE_DESCRIPTOR_HEAPS", false))
+      fprintf(stderr, "DZN_CPU_DESCRIPTOR_POOL_SUMMARY allocations=%llu reused_ranges=%llu backing_pages_created=%llu backing_pages_peak=%llu remaining_pages=%llu\n",
+         (unsigned long long)device->cpu_descriptor_allocations,
+         (unsigned long long)device->cpu_descriptor_reuses,
+         (unsigned long long)device->cpu_descriptor_pages_created,
+         (unsigned long long)device->cpu_descriptor_pages_peak,
+         (unsigned long long)device->cpu_descriptor_pages_live);
+   struct dzn_cpu_descriptor_page *page = device->cpu_descriptor_pages;
+   while (page) {
+      struct dzn_cpu_descriptor_page *next = page->next;
+      util_vma_heap_finish(&page->slots);
+      ID3D12DescriptorHeap_Release(page->heap);
+      free(page);
+      page = next;
+   }
+   device->cpu_descriptor_pages = NULL;
+   mtx_destroy(&device->cpu_descriptor_pool_lock);
+   device->cpu_descriptor_pool_initialized = false;
+}
