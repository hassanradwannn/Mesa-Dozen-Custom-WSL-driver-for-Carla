+/* Descriptor tables can retain references to resources no longer used by a
+ * shader. Never dereference a stale CPU-side resource pointer while inspecting
+ * those tables. A generation also detects reuse of an allocator address.
+ */
+static bool
+dzn_cmd_buffer_snapshot_uniform(struct dzn_cmd_buffer *cmdbuf,
+                                struct dzn_device *device,
+                                struct dzn_descriptor_heap *heap, uint32_t slot,
+                                const struct dzn_buffer_desc *info)
+{
+   if (!info->buffer || !device->snapshot_live_buffers)
+      return false;
+   DZN_PROFILE_BEGIN(device);
+   /* Independent command buffers may record concurrently. Readers can overlap;
+    * buffer insertion, destruction and memory release remain exclusive.
+    */
+   u_rwlock_rdlock(&device->snapshot_buffers_lock);
+   struct hash_entry *entry = _mesa_hash_table_search(device->snapshot_live_buffers, info->buffer);
+   bool live = entry && (uint64_t)(uintptr_t)entry->data == info->snapshot_generation;
+   bool result = live && dzn_cmd_buffer_snapshot_uniform_live(cmdbuf, device, heap, slot, info);
+   if (!live && getenv("DZN_DIAG_ALLOC")) {
+      static unsigned trace_count;
+      if (p_atomic_inc_return(&trace_count) <= 16)
+         fprintf(stderr, "DZN_STALE_UNIFORM generation=%llu\n", (unsigned long long)info->snapshot_generation);
+   }
+   u_rwlock_rdunlock(&device->snapshot_buffers_lock);
+   DZN_PROFILE_END("dzn_cmd_buffer_snapshot_uniform", 1);
+   return result;
+}
